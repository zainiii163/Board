{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "express",
      "installCommand": "cd .. && npm ci --include=dev",
      "buildCommand": "npx tsc -p tsconfig.json",
      "functions": {
        "src/server.ts": {
          "maxDuration": 60,
          "includeFiles": "{src/db/migrations/**,public/**,dist/**}"
        }
      }
    },
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs",
      "installCommand": "cd .. && npm ci --include=dev",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/uploads/(.*)", "destination": { "service": "backend" } },
    { "source": "/demo-pdfs/(.*)", "destination": { "service": "backend" } },
    { "source": "/book-covers/(.*)", "destination": { "service": "backend" } },
    { "source": "/backend-api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
