PORT=4000

NODE_ENV=development

# Apply pending drizzle migrations automatically on boot (default true). Set to false
# if you prefer to run `npm run db:migrate -w backend` manually.

AUTO_MIGRATE=true



# PostgreSQL — required for real persisted CMS data (admin edits survive restarts)

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/boardnotes



# JWT secret for auth tokens (required in production — use a long random string)

JWT_SECRET=boardnotes-dev-secret-change-me



# Comma-separated frontend origins allowed by CORS (production example below)

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com



# Public URL of this API (optional — used for absolute asset links in production)

# PUBLIC_API_URL=https://api.your-domain.com



# Public URL of the Next.js site (used in email links)

# PUBLIC_SITE_URL=https://your-domain.com



# Optional email notifications (contact form, mistake reports, classroom updates)

# NOTIFY_EMAIL=admin@boardnotes.com

# SMTP_HOST=smtp.example.com

# SMTP_PORT=587

# SMTP_USER=

# SMTP_PASS=

# SMTP_FROM=noreply@boardnotes.com



# Optional Cloudflare R2 object storage for PDF uploads (falls back to local disk when unset)

# R2_BUCKET=boardnotes-pdfs

# R2_ACCESS_KEY=

# R2_SECRET_KEY=

# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Optional public base URL for direct PDF links (R2 public bucket or custom domain)

# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

